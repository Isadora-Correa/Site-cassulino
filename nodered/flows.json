[
  {
    "id": "tab-iot-pipeline",
    "type": "tab",
    "label": "IoT Pipeline",
    "disabled": false,
    "info": "Fluxo MQTT -> Node-RED -> InfluxDB/API"
  },
  {
    "id": "mqtt-input",
    "type": "mqtt in",
    "z": "tab-iot-pipeline",
    "name": "ESP32 Sensors",
    "topic": "greenhouse/sensors",
    "qos": "0",
    "datatype": "auto",
    "broker": "mqtt-broker-config",
    "x": 130,
    "y": 120,
    "wires": [["json-parser"]]
  },
  {
    "id": "json-parser",
    "type": "json",
    "z": "tab-iot-pipeline",
    "name": "Parse JSON",
    "property": "payload",
    "action": "",
    "pretty": false,
    "x": 330,
    "y": 120,
    "wires": [["classify-reading"]]
  },
  {
    "id": "classify-reading",
    "type": "function",
    "z": "tab-iot-pipeline",
    "name": "Classify Reading",
    "func": "const data = msg.payload;\nlet classification = 'normal';\nif (data.co2 > 1100 || data.temperature > 33) {\n  classification = 'critico';\n} else if (data.co2 > 900 || data.temperature > 30 || data.humidity < 40) {\n  classification = 'alerta';\n}\nmsg.payload.classification = classification;\nmsg.headers = { 'Content-Type': 'application/json' };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 560,
    "y": 120,
    "wires": [["api-request", "debug-node", "influx-out"]]
  },
  {
    "id": "api-request",
    "type": "http request",
    "z": "tab-iot-pipeline",
    "name": "Send to API",
    "method": "POST",
    "ret": "txt",
    "paytoqs": "ignore",
    "url": "http://localhost:3001/api/ingest",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "x": 790,
    "y": 80,
    "wires": [[]]
  },
  {
    "id": "debug-node",
    "type": "debug",
    "z": "tab-iot-pipeline",
    "name": "Payload",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 780,
    "y": 120,
    "wires": []
  },
  {
    "id": "influx-out",
    "type": "influxdb out",
    "z": "tab-iot-pipeline",
    "influxdb": "influx-config",
    "name": "InfluxDB",
    "measurement": "greenhouse_metrics",
    "precision": "",
    "retentionPolicy": "",
    "database": "iot",
    "precisionV18FluxV20": "ms",
    "retentionPolicyV18Flux": "",
    "org": "",
    "bucket": "iot",
    "x": 790,
    "y": 160,
    "wires": []
  },
  {
    "id": "mqtt-broker-config",
    "type": "mqtt-broker",
    "name": "Mosquitto",
    "broker": "localhost",
    "port": "1883",
    "clientid": "",
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "influx-config",
    "type": "influxdb",
    "hostname": "localhost",
    "port": "8086",
    "protocol": "http",
    "database": "iot",
    "name": "Influx Local"
  }
]
